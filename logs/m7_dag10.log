       causal  '0 + 65 = 65'
       global  '53 - 84 = 9'
  block 3  want '-19 - -6 = -13'
       causal  '24 - -6 = 28'
       global  '26 - -2 = 42'
  block 3  want '100 - 64 = 36'
       causal  '-2 - 42 = -40'
       global  '99 - 42 = 47'
  block 3  want '23 + 9 = 32'
       causal  '13 - 54 = -31'
       global  '19 - 49 = 31'
  block 2  want '16 + 30 = 46'
       causal  '81 + -81 = 41'
       global  '82 - 48 = 16'
